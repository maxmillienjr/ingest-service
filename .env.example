# Copy to .env for local development. Every value shown is the default.
# Validated at boot (src/config/env.schema.ts); a bad value fails the start.

MONGO_URI=mongodb://localhost:27017/ingest
PORT=3000
# api | worker | both
ROLE=both

# Processing
WORKER_CONCURRENCY=100
PROCESSING_DELAY_MS=5000
FAILURE_RATE=0
ORDERING_GRACE_MS=2000
# Must be at least twice PROCESSING_DELAY_MS: a lock is not renewed during the call.
LEASE_TTL_MS=30000
MAX_ATTEMPTS=5
RETRY_BASE_MS=1000
RETRY_MAX_MS=60000
SHUTDOWN_GRACE_MS=15000
POLL_IDLE_MS=250
